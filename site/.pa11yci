{
  "//": "The accessibility gate (design-system.md §7, runbook run-the-a11y-gate). Paths are site-relative; scripts/a11y.mjs prefixes the base, doubles the list with ?theme=light and ?theme=dark, and serves dist/ before running. WCAG 2.1 AA via the axe-core runner; WCAG 2.2's focus-appearance and target-size criteria are design requirements checked in review, because axe does not test them reliably.",
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe"],
    "timeout": 60000,
    "wait": 250,
    "//concurrency": "One at a time. Concurrent pa11y workers share a Chrome instance and lose targets ('Protocol error (Target.closeTarget)'), which reports as 'Failed to run' rather than as a pass or a fail — a gate that silently skips pages is worse than a slow one.",
    "concurrency": 1,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-dev-shm-usage"]
    }
  },
  "paths": [
    "/",
    "/search/",
    "/browse/",
    "/record/doi-10-2172-2447928/",
    "/record/doi-10-2314-kxp-1790028361/",
    "/record/doi-10-5281-zenodo-20847799/",
    "/dev/components/"
  ],
  "why": {
    "/": "the homepage, and the freshness banner",
    "/search/": "the page a screen-reader user lives on",
    "/browse/": "the no-JavaScript path, and pagination",
    "//records": "Three REAL harvested records, not fixtures. Fixture-shaped record pages are already audited through /dev/components; these prove the gate holds over what the pipeline actually produced.",
    "/record/doi-10-2172-2447928/": "the rich one (OSTI): seven keyword tags, a task group, a resource, two related identifiers, a 3,200-character abstract and a very long author list — the widest set of surfaces any real record lights up",
    "/record/doi-10-2314-kxp-1790028361/": "the sparse one (DataCite): no abstract, no resources, no group, no task attribution — and its stated licence, 'Open Access', is not in the licence table, so it also renders the unrecognised-licence warning panel",
    "/record/doi-10-5281-zenodo-20847799/": "the task-attributed one (Zenodo): a task chip, a group, a resource and a related identifier together. No record in this harvest is withdrawn or retracted, so this stands in as the record carrying the most task and source attribution; the withdrawn banner and retraction flag are audited on fixtures r-04 and rep-06 in /dev/components/",
    "/dev/components/": "the gallery — every component in every fixture state, plus the token swatches, so one URL audits the whole inventory AND the palette"
  }
}
