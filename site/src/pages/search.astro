---
import Base from '../layouts/Base.astro';
import SearchIsland from '../components/SearchIsland.astro';
import { catalogue } from '../lib/catalogue';
import { facetsFor } from '../lib/facets';

const entries = await catalogue();
const facets = facetsFor(entries);
const initial = entries.slice(0, 10).map((entry) => entry.pkg);
---

<Base
  title="Search — IEA Wind Data Catalogue"
  description="Search the IEA Wind Data Catalogue by task, resource kind, year, licence and source."
>
  <h1>Search</h1>
  <p class="prose secondary">
    Search runs entirely in your browser: the index is a build artifact, there is
    no server to ask and nothing is logged. Filters combine, and an empty query
    with filters set is a perfectly good way to browse.
  </p>

  <SearchIsland facets={facets} initial={initial} total={entries.length} />
</Base>

<style>
  h1 {
    margin-bottom: var(--space-2);
  }

  p {
    margin-bottom: var(--space-6);
  }
</style>
