---
/**
 * The static, paginated list of everything. This is the no-JavaScript path and
 * the crawler's path: plain HTML, real links, no index required.
 */
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import RecordCard from '../../components/RecordCard.astro';
import Pagination from '../../components/Pagination.astro';
import { catalogue } from '../../lib/catalogue';
import { BROWSE_PAGE_SIZE } from '../../lib/paginate';
import { withBase } from '../../lib/url';
import type { CkanPackage } from '../../lib/record';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const entries = await catalogue();
  return paginate(entries.map((entry) => entry.pkg), { pageSize: BROWSE_PAGE_SIZE });
};

const { page } = Astro.props as { page: Page<CkanPackage> };
---

<Base
  title={
    page.currentPage === 1
      ? 'Browse — IEA Wind Data Catalogue'
      : `Browse, page ${page.currentPage} — IEA Wind Data Catalogue`
  }
  description="Every record in the IEA Wind Data Catalogue, newest first."
>
  <h1>Browse the catalogue</h1>
  <p class="secondary">
    {page.total} record{page.total === 1 ? '' : 's'}, most recently confirmed first.
    Showing {page.start + 1}–{page.end + 1}.{' '}
    <a href={withBase('/search/')}>Search and filter instead →</a>
  </p>

  <ul class="cards">
    {page.data.map((pkg) => (
      <li><RecordCard pkg={pkg} /></li>
    ))}
  </ul>

  <Pagination page={page.currentPage} pageCount={page.lastPage} />
</Base>

<style>
  h1 {
    margin-bottom: var(--space-2);
  }

  .cards {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
  }
</style>
