---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import SearchIsland from '../components/SearchIsland.astro';
import { catalogue, usingFixtures } from '../lib/catalogue';
import { facetsFor } from '../lib/facets';
import { freshness } from '../lib/state';
import { formatDate } from '../lib/record';
import { withBase } from '../lib/url';
import { CATALOGUE_PAGE_SIZE } from '../lib/paginate';

// The catalogue is the index: search box + filter sidebar + the whole record
// set, server-rendered and paginated. `catalogue()` returns entries sorted by
// their `published_date` extra newest-first, which is the "most recently
// published" order the results default to.
const entries = await catalogue();
const sample = await usingFixtures();
const fresh = freshness();
const facets = facetsFor(entries);
const records = entries.map((entry) => entry.pkg);
const statusHref = withBase('/about/#status');
---

<Base
  title="IEA Wind Data Catalogue"
  description="Datasets, publications and software from the IEA Wind Tasks, harvested from where they are already published."
>
  <div class="catalogue-page">
    <header class="catalogue__head">
      <div class="catalogue__headline">
        <h1 class="catalogue__title">Datasets, publications and software from the IEA&nbsp;Wind Tasks</h1>
        <p class="catalogue__lead prose">
          This catalogue watches the places IEA Wind contributors typically
          publish — Zenodo, DataCite, Crossref, GitHub, OSTI, the Wind Data Hub
          and the Task sites — and curates this searchable list of IEA Wind and
          related publications.
        </p>
      </div>

      <aside class="status" aria-label="Catalogue status">
        <p class="status__label">Status</p>
        {fresh.neverRun ? (
          <p class="status__line"><a href={statusHref}>Not harvested yet</a></p>
        ) : (
          <>
            <p class="status__line">
              <a href={statusHref}>Last updated {formatDate(fresh.finishedAt)}</a>
            </p>
            <p class="status__meta secondary">
              {fresh.ageDays === 0
                ? 'today'
                : `${fresh.ageDays} day${fresh.ageDays === 1 ? '' : 's'} ago`}
              {fresh.stale ? ' · refresh due' : ''}
            </p>
          </>
        )}
      </aside>
    </header>

    {sample && (
      <Panel tone="info" icon="ℹ" heading="Showing sample records" headingLevel="h2">
        <p>
          <code>records/</code> is empty in this checkout, so the site is
          rendering the <code>fixtures/rendering/</code> set instead — including
          the deliberately awkward ones. Run <code>make harvest</code> and these
          disappear the moment a real record exists.
        </p>
      </Panel>
    )}

    <SearchIsland
      facets={facets}
      initial={records}
      total={entries.length}
      pageSize={CATALOGUE_PAGE_SIZE}
    />
  </div>
</Base>

<style>
  /* Give the catalogue room to breathe: the header, the search box and the
     results are three distinct movements, so they get generous vertical air
     rather than the tight default rhythm. */
  .catalogue-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* Title + description on the left, the status card top-right of the page —
     a two-column header with the status aligned to the title's top edge. */
  .catalogue__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: start;
  }

  .catalogue__headline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .catalogue__title {
    margin: 0;
    max-width: 20ch;
  }

  @media (max-width: 48rem) {
    .catalogue__head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .catalogue__lead {
    margin: 0;
    font-size: var(--font-size-body);
    /* Inter 300 (the light cut) — a step lighter and smaller than a lead. */
    font-weight: 300;
  }

  /* A compact, barred status card — square corners, neutral surface, the accent
     appears only as the left bar (design §1). It links to /about/#status. */
  .status {
    justify-self: end;
    max-width: 16rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-inline-start: var(--panel-bar-width) solid var(--panel-accent-bar);
    background: var(--surface-raised);
  }

  @media (max-width: 48rem) {
    .status {
      justify-self: stretch;
      max-width: none;
    }
  }

  .status p {
    margin: 0;
  }

  .status__label {
    color: var(--text-secondary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status__line {
    margin-block-start: var(--space-1);
    font-size: var(--font-size-small);
  }

  .status__line a {
    text-decoration: none;
  }

  .status__line a:hover {
    text-decoration: underline;
  }

  .status__meta {
    margin-block-start: var(--space-1);
    font-size: var(--font-size-caption);
  }
</style>
