---
/**
 * The catalogue's search-and-filter island (ADR-0023, ADR-0036).
 *
 * The whole record set is server-rendered here as real `RecordCard`s, each in a
 * `<li>` carrying the facet values as `data-*` attributes. That means the zero-JS
 * reader and the crawler see the entire catalogue in plain HTML — the filtering
 * is a progressive enhancement layered on top, not a prerequisite for reading.
 *
 * The island reads the shared filter vocabulary from the query string
 * (`task`, `kind`, `year`, `licence`, `source`, `institution`, `availability`,
 * `q`, `page`), applies it over the embedded set, updates the list, the live
 * count and the facet counts in place, and rewrites the URL so a filtered view
 * is shareable. It needs no index and no network, so it works identically under
 * `astro dev` (where Pagefind does not exist) and in the built site — which is
 * why there is no `pagefind.js` import here to 404.
 *
 * Filters are real checkboxes rendered server-side (design §6: "never clickable
 * `<div>`s"); the count and the zero-results state announce through one polite
 * live region.
 */
import FacetGroup from './FacetGroup.astro';
import type { Facet } from '../lib/facets';
import TextInput from './TextInput.astro';
import Button from './Button.astro';
import RecordCard from './RecordCard.astro';
import {
  extra,
  tasksOf,
  sourceSystemsOf,
  yearOf,
  plainText,
  authorsOf,
  availabilityOf,
  type CkanPackage,
} from '../lib/record';

interface Props {
  facets: Facet[];
  /** Every record to embed, filter and paginate. */
  initial: CkanPackage[];
  total?: number;
  pageSize?: number;
}
const { facets, initial, pageSize = 20 } = Astro.props;

const searchText = (pkg: CkanPackage): string =>
  [
    pkg.title,
    authorsOf(pkg)
      .map((a) => a.name)
      .join(' '),
    tasksOf(pkg).join(' '),
    extra(pkg, 'doi') ?? '',
    plainText(pkg.notes).slice(0, 600),
  ]
    .join(' ')
    .toLowerCase();

const rows = initial.map((pkg) => ({
  pkg,
  task: tasksOf(pkg).join(' '),
  kind: extra(pkg, 'resource_kind') ?? '',
  year: yearOf(pkg),
  licence: pkg.license_id ?? '',
  source: sourceSystemsOf(pkg).join(' '),
  institution: pkg.owner_org ?? '',
  availability: availabilityOf(pkg),
  text: searchText(pkg),
}));
const shown = rows.length;
---

<search-island class="search" data-page-size={pageSize}>
  <form class="search__form" role="search" action="?" method="get">
    <div class="search__query">
      <TextInput
        id="q"
        name="q"
        type="search"
        label="Search"
        placeholder="lidar, wake, Task 43, an author, a DOI…"
        autocomplete="off"
        data-search-input
      />
      <Button variant="primary" type="submit" data-search-submit>Search</Button>
    </div>

    <noscript>
      <p class="secondary search__noscript">
        Filtering and pagination need JavaScript. The full catalogue —
        all {shown} record{shown === 1 ? '' : 's'}, most recently updated first — is
        listed below without it.
      </p>
    </noscript>

    <div class="search__layout">
      <div class="search__facets">
        <div class="search__facets-head">
          <h2 class="section-label">Filter</h2>
          <button class="search__clear" type="reset" data-search-clear>Clear all</button>
        </div>
        {facets.map((facet) => (
          <FacetGroup name={facet.name} legend={facet.legend} values={facet.values} />
        ))}
      </div>

      <div class="search__results">
        <p class="search__count" role="status" aria-live="polite" data-search-count>
          Showing all {shown} record{shown === 1 ? '' : 's'}, most recently updated first.
        </p>

        <ul class="search__list" data-search-results>
          {rows.map((row) => (
            <li
              data-task={row.task}
              data-kind={row.kind}
              data-year={row.year}
              data-licence={row.licence}
              data-source={row.source}
              data-institution={row.institution}
              data-availability={row.availability}
              data-text={row.text}
            >
              <RecordCard pkg={row.pkg} />
            </li>
          ))}
        </ul>

        <div class="search__empty" data-search-empty-slot hidden></div>
        <template data-search-empty>
          <div class="search__empty-card">
            <p><strong>No results.</strong></p>
            <p class="secondary">
              Try fewer filters, or a broader term. The catalogue only holds what
              its sources publish, so an absent record usually means nobody has
              deposited it yet.
            </p>
          </div>
        </template>

        <nav class="pagination" aria-label="Catalogue pages" data-search-pagination hidden></nav>
      </div>
    </div>
  </form>
</search-island>

<script>
  // Vanilla custom element (design §3.7). No Pagefind, no network: the record
  // set is embedded in the page, so filtering works under `astro dev` exactly as
  // it does in the built site, and there is no missing index to 404 on.
  class SearchIsland extends HTMLElement {
    connectedCallback() {
      const root = this;
      const form = root.querySelector('form');
      const input = root.querySelector('[data-search-input]');
      const list = root.querySelector('[data-search-results]');
      const count = root.querySelector('[data-search-count]');
      const emptySlot = root.querySelector('[data-search-empty-slot]');
      const emptyTemplate = root.querySelector('[data-search-empty]');
      const pager = root.querySelector('[data-search-pagination]');
      const clear = root.querySelector('[data-search-clear]');
      if (!form || !input || !list || !count || !pager) return;

      const items = Array.from(list.querySelectorAll('li'));
      const pageSize = Math.max(1, parseInt(root.dataset.pageSize || '20', 10) || 20);
      const FACETS = ['task', 'kind', 'year', 'licence', 'source', 'institution', 'availability'];
      const MULTI = new Set(['task', 'source']);

      const valuesOf = (li, facet) => {
        const raw = (li.dataset[facet] || '').trim();
        if (!raw) return [];
        return MULTI.has(facet) ? raw.split(/\s+/) : [raw];
      };

      const matches = (li, sel, tokens, except) => {
        for (const facet of FACETS) {
          if (facet === except) continue;
          const chosen = sel[facet];
          if (!chosen || chosen.length === 0) continue;
          const has = valuesOf(li, facet);
          if (!chosen.some((value) => has.includes(value))) return false;
        }
        if (tokens.length) {
          const text = li.dataset.text || '';
          if (!tokens.every((token) => text.includes(token))) return false;
        }
        return true;
      };

      const gather = () => {
        const sel = {};
        for (const box of root.querySelectorAll('.facet__input:checked')) {
          (sel[box.name] = sel[box.name] || []).push(box.value);
        }
        const q = input.value.trim();
        const tokens = q ? q.toLowerCase().split(/\s+/) : [];
        return { sel, tokens, q };
      };

      let page = 1;

      const writeUrl = (sel, q) => {
        const params = new URLSearchParams();
        for (const facet of FACETS) for (const value of sel[facet] || []) params.append(facet, value);
        if (q) params.set('q', q);
        if (page > 1) params.set('page', String(page));
        // `?theme=` is the a11y gate's and it is not ours to drop.
        const theme = new URLSearchParams(window.location.search).get('theme');
        if (theme) params.set('theme', theme);
        const query = params.toString();
        window.history.replaceState({}, '', query ? `?${query}` : window.location.pathname);
      };

      const updateCounts = (sel, tokens) => {
        for (const node of root.querySelectorAll('[data-facet-count]')) {
          const raw = node.dataset.facetCount || '';
          const idx = raw.indexOf(':');
          const facet = raw.slice(0, idx);
          const value = raw.slice(idx + 1);
          let c = 0;
          for (const li of items) {
            if (matches(li, sel, tokens, facet) && valuesOf(li, facet).includes(value)) c += 1;
          }
          node.textContent = String(c);
        }
      };

      const renderPager = (pageCount) => {
        pager.textContent = '';
        if (pageCount <= 1) {
          pager.hidden = true;
          return;
        }
        pager.hidden = false;
        const ul = document.createElement('ul');
        ul.className = 'pagination__list';

        const wanted = [];
        for (let n = 1; n <= pageCount; n += 1) {
          if (n === 1 || n === pageCount || Math.abs(n - page) <= 1) wanted.push(n);
        }

        const addLink = (n, label, rel) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'pagination__link';
          a.href = '#';
          a.textContent = label || String(n);
          if (rel) a.rel = rel;
          if (!label && n === page) a.setAttribute('aria-current', 'page');
          a.addEventListener('click', (event) => {
            event.preventDefault();
            page = n;
            apply(false);
            count.focus?.();
          });
          li.appendChild(a);
          ul.appendChild(li);
        };

        if (page > 1) addLink(page - 1, '← Previous', 'prev');
        let prev = 0;
        for (const n of wanted) {
          if (prev && n - prev > 1) {
            const gap = document.createElement('li');
            gap.className = 'pagination__gap';
            gap.setAttribute('aria-hidden', 'true');
            gap.textContent = '…';
            ul.appendChild(gap);
          }
          addLink(n);
          prev = n;
        }
        if (page < pageCount) addLink(page + 1, 'Next →', 'next');
        pager.appendChild(ul);
      };

      const apply = (resetPage = true) => {
        const { sel, tokens, q } = gather();
        if (resetPage) page = 1;

        const filtered = items.filter((li) => matches(li, sel, tokens, null));
        const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
        if (page > pageCount) page = pageCount;
        const start = (page - 1) * pageSize;
        const visible = new Set(filtered.slice(start, start + pageSize));
        for (const li of items) li.hidden = !visible.has(li);

        emptySlot.textContent = '';
        if (filtered.length === 0 && emptyTemplate) {
          emptySlot.hidden = false;
          emptySlot.appendChild(emptyTemplate.content.cloneNode(true));
        } else {
          emptySlot.hidden = true;
        }

        const describe = q ? ` for “${q}”` : '';
        const noun = (n) => `record${n === 1 ? '' : 's'}`;
        if (filtered.length === 0) {
          count.textContent = `No results${describe}.`;
        } else if (pageCount > 1) {
          count.textContent =
            `${filtered.length} ${noun(filtered.length)}${describe} — page ${page} of ${pageCount}.`;
        } else {
          count.textContent = `${filtered.length} ${noun(filtered.length)}${describe}.`;
        }

        updateCounts(sel, tokens);
        renderPager(pageCount);
        writeUrl(sel, q);
      };

      // Hydrate the controls from the URL (a filter link lands here).
      const params = new URLSearchParams(window.location.search);
      const q0 = params.get('q');
      if (q0) input.value = q0;
      for (const box of root.querySelectorAll('.facet__input')) {
        if (params.getAll(box.name).includes(box.value)) box.checked = true;
      }
      const p0 = parseInt(params.get('page') || '1', 10);
      page = Number.isFinite(p0) && p0 > 0 ? p0 : 1;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        apply();
      });
      let timer;
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => apply(), 200);
      });
      for (const box of root.querySelectorAll('.facet__input')) {
        box.addEventListener('change', () => apply());
      }
      if (clear) {
        clear.addEventListener('click', () => {
          window.setTimeout(() => {
            input.value = '';
            for (const box of root.querySelectorAll('.facet__input')) box.checked = false;
            apply();
          }, 0);
        });
      }

      // Filter chips inside a result card link to `?param=value`. On the
      // catalogue page a plain navigation to that href would DROP every other
      // active filter, so intercept the click and ADD the value to the current
      // selection instead. Off this page (a record page) the identical link is
      // left alone as an ordinary navigation, so chips work with no JS too.
      root.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target.closest('a');
        if (!link) return;
        let url;
        try {
          url = new URL(link.href, window.location.href);
        } catch {
          return;
        }
        if (url.pathname !== window.location.pathname) return;
        const keys = Array.from(url.searchParams.keys()).filter((k) => k !== 'theme');
        if (keys.length !== 1) return;
        const param = keys[0];
        if (!FACETS.includes(param)) return;
        const value = url.searchParams.get(param);
        const escaped = window.CSS && CSS.escape ? CSS.escape(value) : value;
        const box = root.querySelector(`.facet__input[name="${param}"][value="${escaped}"]`);
        if (!box) return;
        event.preventDefault();
        box.checked = true; // additive — every other active filter is kept
        const details = box.closest('details');
        if (details) details.open = true; // reveal it if it was folded away
        apply();
      });

      // Initial paint: honour the URL's page without resetting it to 1.
      apply(false);
    }
  }
  if (!customElements.get('search-island')) customElements.define('search-island', SearchIsland);
</script>

<style>
  .search__query {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .search__query :global(.field) {
    flex: 1;
    min-width: 0;
    gap: var(--space-2);
  }

  /* "Search" reads as the same kind of section label as "Filter" — one small
     uppercase eyebrow system across the page (ITEM 2). The <label> keeps its
     job as the input's accessible name; only its appearance changes here. */
  .search__query :global(.field__label) {
    color: var(--text-secondary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* The shared section-label eyebrow: "Search" and "Filter" match exactly. */
  .section-label {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search__noscript {
    margin-bottom: var(--space-6);
  }

  .search__layout {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .search__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .search__facets-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .search__clear {
    min-height: var(--space-6);
    padding: 0 var(--space-2);
    border: 0;
    background: transparent;
    color: var(--text-link);
    font: inherit;
    font-size: var(--font-size-small);
    cursor: pointer;
  }

  .search__clear:hover {
    color: var(--action-hover);
    text-decoration: underline;
  }

  .search__count {
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--font-size-small);
  }

  .search__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search__list li[hidden] {
    display: none;
  }

  .search__empty[hidden] {
    display: none;
  }

  .search__empty-card {
    padding: var(--space-6) var(--space-4);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    text-align: center;
  }

  /* The pager is built by the island, so its nodes carry no scope attribute and
     must be reached with :global. Tokens only, same look as Pagination.astro. */
  .search :global(.pagination) {
    margin-block-start: var(--space-6);
  }

  .search :global(.pagination__list) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search :global(.pagination__link) {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-8);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--text-link);
    font-size: var(--font-size-small);
    text-decoration: none;
  }

  .search :global(.pagination__link:hover) {
    border-color: var(--action-primary);
  }

  .search :global(.pagination__link[aria-current='page']) {
    border-color: var(--action-primary);
    color: var(--text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .search :global(.pagination__gap) {
    color: var(--text-secondary);
  }
</style>
