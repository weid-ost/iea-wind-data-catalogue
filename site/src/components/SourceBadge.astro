---
/**
 * "Where this came from", with the link that matters: **report an issue at the
 * source**. The catalogue is an aggregator, not an authority — a typo'd title
 * is what Zenodo says, and the fix belongs at Zenodo, where the author can make
 * it and every other consumer benefits (plan §4.2).
 *
 * The source name itself is a filter link into the catalogue's source facet
 * (item 14b), reusing the `Badge` chip so it matches the family (item 10); the
 * two outbound links go to the record at the source and its issue tracker, and
 * each says where it goes.
 */
import Badge from './Badge.astro';
import { sourceLabel } from '../lib/record';
import { filterHref } from '../lib/url';
import { sourceTip } from '../lib/tooltips';
import { safeHref } from '../safety.mjs';

interface Props {
  system: string;
  url?: string;
  reportUrl?: string;
}
const { system, url: rawUrl, reportUrl: rawReportUrl } = Astro.props;
// Source URLs are upstream strings; the badge is where they become clickable,
// so the scheme allow-list is applied here too (site-01).
const url = safeHref(rawUrl);
const reportUrl = safeHref(rawReportUrl);
const label = sourceLabel(system);
---

<span class="source">
  <Badge mono href={filterHref('source', system)} tip={sourceTip(system)}>{label}</Badge>
  {url && (
    <a class="source__link" href={url} rel="noopener external">
      view at {label}
    </a>
  )}
  {reportUrl && (
    <a class="source__link" href={reportUrl} rel="noopener external">
      report an issue at {label}
    </a>
  )}
</span>

<style>
  .source {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    font-size: var(--font-size-small);
  }
</style>
