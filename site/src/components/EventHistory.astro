---
/**
 * The event log for this record, as a real list with meaningful text rather
 * than icon soup (design §6).
 *
 * `events/` is the source of truth and `records/` is derived from it
 * (ADR-0037), so this is the audit trail: when we first saw the artifact, every
 * time upstream changed, every local annotation, and the withdrawal if there
 * was one. Append-only and append-on-change — a run in which nothing changed
 * writes no line here at all, which is why the list is short.
 */
import { formatDate } from '../lib/record';

interface Props {
  events: Record<string, any>[];
  firstSeen?: string;
  lastSeen?: string;
  /** Scopes the heading id — the gallery renders several of these on one page. */
  id?: string;
}
const { events, firstSeen, lastSeen, id = 'history' } = Astro.props;
const headingId = `${id}-heading`;

const DESCRIPTION: Record<string, string> = {
  scraped: 'Upstream metadata observed and taken wholesale',
  annotated: 'Local annotation added',
  withdrawn: 'Artifact no longer available at the source',
  displacement_notice: 'A source value displaced a locally-added one',
  pin_notice: 'The page changed beneath a pinned extraction',
  merge_proposal: 'The reconciler found a probable duplicate — awaiting review, not merged',
};

const ordered = [...events].sort((a, b) =>
  String(a.observed_at ?? '').localeCompare(String(b.observed_at ?? ''))
);
---

<section class="history" aria-labelledby={headingId}>
  <h2 id={headingId}>Record history</h2>

  {ordered.length === 0 ? (
    <p class="secondary">
      No event log is available for this record in this checkout. `events/` is the
      source of truth; run <code>make harvest</code> to populate it.
      {firstSeen && <> First seen {formatDate(firstSeen)}.</>}
      {lastSeen && <> Last confirmed {formatDate(lastSeen)}.</>}
    </p>
  ) : (
    <ol class="history__list">
      {ordered.map((event) => (
        <li class="history__item">
          <p class="history__when meta secondary">{formatDate(String(event.observed_at))}</p>
          <p class="history__what">
            {DESCRIPTION[String(event.event_type)] ?? String(event.event_type)}
            {event.source_system && <span class="secondary"> · {event.source_system}</span>}
            {event.actor && <span class="secondary"> · by {event.actor}</span>}
          </p>
          {event.note && <p class="history__note secondary">{event.note}</p>}
          {event.source_key && (
            <p class="history__key meta secondary">source key {event.source_key}</p>
          )}
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .history__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .history__item {
    padding: var(--space-3) 0 var(--space-3) var(--space-4);
    border-inline-start: var(--border-width-hairline) solid var(--border-subtle);
  }

  .history__item p {
    margin: 0;
  }

  .history__when,
  .history__key {
    font-size: var(--font-size-caption);
  }

  .history__note {
    font-size: var(--font-size-small);
  }
</style>
