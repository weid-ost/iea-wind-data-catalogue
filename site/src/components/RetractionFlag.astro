---
/**
 * A retraction is a fact the *source* states, via an `IsRetractedBy` related
 * identifier (fixture cr-07). It is emphatically not withdrawal: the work is
 * still at the publisher, and the two banners must read differently or a reader
 * will conflate "we lost it" with "it was wrong".
 */
import Panel from './Panel.astro';
import { safeHref } from '../safety.mjs';

interface Props {
  identifier?: string;
  identifierType?: string;
}
const { identifier, identifierType } = Astro.props;
// A non-DOI related identifier is whatever the source wrote, and it is used as
// the href, so it goes through the scheme allow-list (site-01). The identifier
// itself is still shown beside the link, whether or not it is linkable.
const href =
  identifier && (identifierType ?? 'DOI').toUpperCase() === 'DOI'
    ? `https://doi.org/${identifier}`
    : safeHref(identifier);
---

<Panel tone="danger" icon="⚠" role="status" heading="Retracted" headingLevel="p">
  <p>
    The source states that this work has been retracted. Read the retraction
    notice before citing it.
    {href && (
      <>
        {' '}
        <a href={href} rel="noopener external">Retraction notice</a>{' '}
        <span class="meta secondary">{identifier}</span>
      </>
    )}
  </p>
</Panel>
