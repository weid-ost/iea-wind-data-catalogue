---
/**
 * The button primitive, with all five states (design-system.md §8: "a primitive
 * without its states isn't done"). Renders a real <button> or an <a> — never a
 * clickable div.
 *
 * Note the dark-mode label: the accessible dark action colour cannot reach
 * 4.5:1 under white text, so dark-mode buttons carry near-black labels. That is
 * `--text-on-action`, and it is why the token exists.
 */
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { variant = 'secondary', href, type = 'button', disabled, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['button', `button--${variant}`, className]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={href && disabled ? 'true' : undefined}
  {...rest}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    /* Target size >= 24px is a WCAG 2.2 design requirement; this lands at 40px. */
    min-height: var(--space-8);
    padding: var(--space-2) var(--space-4);
    border: var(--border-width-hairline) solid transparent;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--easing-standard),
      border-color var(--duration-fast) var(--easing-standard);
  }

  .button--primary {
    background: var(--action-primary);
    border-color: var(--action-primary);
    color: var(--text-on-action);
  }

  .button--primary:hover:not(:disabled):not([aria-disabled='true']) {
    background: var(--action-hover);
    border-color: var(--action-hover);
    color: var(--text-on-action);
  }

  .button--primary:active:not(:disabled) {
    background: var(--action-active);
    border-color: var(--action-active);
  }

  .button--secondary {
    background: var(--surface-raised);
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .button--secondary:hover:not(:disabled):not([aria-disabled='true']) {
    border-color: var(--action-primary);
    color: var(--action-primary);
  }

  .button--secondary:active:not(:disabled) {
    background: var(--surface-sunken);
  }

  .button:disabled,
  .button[aria-disabled='true'] {
    background: var(--action-disabled-bg);
    border-color: var(--action-disabled-bg);
    color: var(--action-disabled-text);
    cursor: not-allowed;
  }
</style>
