---
/**
 * An IEA Wind Task attribution — a `Badge` (item 10: one chip family, one place
 * the geometry lives), so it never diverges in size, weight or alignment from
 * the kind, availability and source badges beside it.
 *
 * Design §6: "task chips that filter are buttons, task chips that merely label
 * are text". A chip here navigates to the catalogue filtered to its Task
 * (item 14b, the shared `?task=` contract), so it is a link; passing
 * `href={null}` renders the labelling-only variant as a plain span.
 */
import Badge from './Badge.astro';
import { taskShort } from '../lib/registers';
import { filterHref } from '../lib/url';
import { taskTip } from '../lib/tooltips';

interface Props {
  task: string;
  href?: string | null;
}
const { task, href } = Astro.props;
const label = taskShort(task);
// null => an explicit label-only chip; undefined => the default filter link.
const target = href === null ? null : (href ?? filterHref('task', task));
---

<Badge tone="neutral" href={target} tip={taskTip(task)}>
  <span class="visually-hidden">IEA Wind </span>{label}
</Badge>
