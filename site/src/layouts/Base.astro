---
/**
 * The page frame. One `<main>`, a labelled `<nav>`, a skip link as the first
 * focusable element, a unique `<title>` (design §6).
 *
 * Zero JS by default: the only scripts on a page are the pre-paint theme
 * script, the theme toggle, and — on the search page — the island.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { withBase } from '../lib/url';
import { jsonForHtml } from '../safety.mjs';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Raw JSON-LD, rendered into the built HTML — never injected by script,
   *  because Google Dataset Search is the point (ADR-0023). */
  jsonLd?: unknown;
  lang?: string;
}
const { title, description, noindex, jsonLd, lang = 'en' } = Astro.props;

// `Astro.url.pathname` already carries `base`, and `Astro.site` already carries
// it too (the site URL *is* the deployment root, base included). Stripping the
// leading slash therefore resolved the path *relative to* the base and emitted
// it twice — `…/iea-wind-data-catalogue/iea-wind-data-catalogue/record/x/`.
// Keeping the leading slash resolves against the origin, which is right in both
// deployments: project site (base `/iea-wind-data-catalogue`) and custom domain
// (base `/`). `scripts/check-urls.mjs` fails the build if this ever regresses.
const canonical = new URL(Astro.url.pathname, Astro.site);
// Routes after the single-page consolidation: '/' is the catalogue (search +
// browse in one), '/about/' explains it. The old '/search/' and '/browse/'
// pages are gone.
const NAV = [
  { href: withBase('/'), label: 'Catalogue' },
  { href: withBase('/about/'), label: 'About' },
];
const here = Astro.url.pathname.replace(/\/$/, '');

// The repository, in the header, the way Material for MkDocs puts it there.
// The catalogue IS the repository — the records, the event log, the harvester
// and this site are all one checkout (ADR-0022) — so "view the source" is not
// a footnote for developers, it is the honest answer to "where does this come
// from?" and it belongs where somebody looks first.
const REPO_URL = 'https://github.com/weid-ost/iea-wind-data-catalogue';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/ld+json" href={withBase('/catalog.jsonld')} title="DCAT catalogue" />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('/fonts/inter-latin-400-normal.woff2')}
      crossorigin
    />
    {/* `jsonForHtml`, never `JSON.stringify`: stringify does not escape `<`,
        so a harvested title containing `</script>` closed this element and the
        rest of the title became live HTML (scrape-01). */}
    {jsonLd && <script type="application/ld+json" set:html={jsonForHtml(jsonLd)} />}
    <script is:inline>
      // Applied before first paint so the stored choice never flashes. Two
      // lines, inline, deliberately not bundled (design-system.md §5).
      (() => {
        const forced = new URLSearchParams(location.search).get('theme');
        const mode = forced || localStorage.getItem('theme');
        if (mode === 'light' || mode === 'dark') document.documentElement.dataset.theme = mode;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <p class="site-header__title">
          <a href={withBase('/')}>IEA Wind Data Catalogue</a>
        </p>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={here === item.href.replace(/\/$/, '') ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              {/* Marked `external` and given its own accessible name: the icon
                  is decorative and a link that is only an icon is a link with
                  no text for a screen reader. */}
              <a class="site-nav__repo" href={REPO_URL} rel="noopener external">
                <svg
                  class="site-nav__icon"
                  viewBox="0 0 16 16"
                  width="16"
                  height="16"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    fill="currentColor"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  />
                </svg>
                <span>GitHub</span>
              </a>
            </li>
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>
          <a href={withBase('/catalog.jsonld')}>DCAT export</a> ·
          <a href={withBase('/about/')}>How this works</a> ·
          <a href="https://github.com/weid-ost/iea-wind-data-catalogue" rel="noopener external">
            Source on GitHub
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
